# 웹훅 URL만 넣으면 메뉴 전송은 됩니다. 사진까지 다른 방 급식봇처럼 보내려면
# 웰스토리플러스(구내식당 앱) 로그인도 함께 넣어 주세요.

# 보낼 방이 하나면 이것만, 여러 방이면 아래 MATTERMOST_WEBHOOK_URLS 를 쓰세요.
MATTERMOST_WEBHOOK_URL=
# 방마다 웹훅을 따로 만들어 콤마로 이어 붙입니다. 둘 다 있으면 합쳐서 전부 보냅니다.
MATTERMOST_WEBHOOK_URLS=

# 웹훅 대신 API 토큰으로 보낼 때만 필요합니다.
MATTERMOST_URL=https://meeting.ssafy.com
MATTERMOST_CHANNEL_ID=9ac0b84f5d7b6f81293023d1245cd537
MATTERMOST_TOKEN=

WELLSTORY_CAMPUS=전기부산
WELLSTORY_RESTAURANT_CODE=REST000595

# 웰스토리 원본 사진 — 브라우저 콘솔로 welplus 에 로그인해 받은 accessToken.
# 넣으면 폴백보다 먼저 시도합니다. 받는 방법은 README "웰스토리 원본 사진 쓰기" 참고.
WELLSTORY_ACCESS_TOKEN=
# (선택) 로그인 응답의 deviceId. 서버가 요구할 때만 필요합니다.
WELLSTORY_DEVICE_ID=
# (구버전 경로) 세션 쿠키를 주는 계정이면 이쪽도 됩니다.
WELLSTORY_REMEMBER_ME=
WELLSTORY_JSESSIONID=
# ID/PW 로그인은 Incapsula WAF에 막혀 현재 동작하지 않습니다(맨 마지막에만 시도).
WELLSTORY_USERNAME=
WELLSTORY_PASSWORD=

# 사진 폴백 2 — welstory-meal.cloud (false 로 끄기)
MEALCLOUD_URL=https://welstory-meal.cloud
MEALCLOUD_ENABLED=true

# 실제 점심 사진은 배식 직전(대개 10:30 전후)에야 웰스토리에 올라옵니다.
# 그전에는 플레이스홀더뿐이라, 사진이 올라올 때까지 아래 시간만큼 기다렸다 보냅니다.
# 0 으로 두면 기다리지 않고 사진 없이 바로 보냅니다.
PHOTO_WAIT_MINUTES=25
PHOTO_POLL_SECONDS=60

TIMEZONE=Asia/Seoul
