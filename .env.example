# 웹훅 URL만 넣으면 메뉴 전송은 됩니다. 사진까지 다른 방 급식봇처럼 보내려면
# 웰스토리플러스(구내식당 앱) 로그인도 함께 넣어 주세요.

MATTERMOST_WEBHOOK_URL=

# 웹훅 대신 API 토큰으로 보낼 때만 필요합니다.
MATTERMOST_URL=https://meeting.ssafy.com
MATTERMOST_CHANNEL_ID=9ac0b84f5d7b6f81293023d1245cd537
MATTERMOST_TOKEN=

WELLSTORY_CAMPUS=전기부산
WELLSTORY_RESTAURANT_CODE=REST000595

# 사진 폴백 1 — 웰스토리 앱 아이디/비번 (웹 로그인 화면 없어도 API로 동작)
WELLSTORY_USERNAME=
WELLSTORY_PASSWORD=
# (선택) 브라우저에서 welplus 로그인이 되는 경우에만 remember-me / JSESSIONID
WELLSTORY_REMEMBER_ME=
WELLSTORY_JSESSIONID=

# 사진 폴백 2 — BOB SSAFY (false 로 끄기)
BOBSSAFY_URL=https://bobssafy.streamlit.app/
BOBSSAFY_ENABLED=true
BOBSSAFY_TIMEOUT_MS=

TIMEZONE=Asia/Seoul
